{
  "name": "@rahulmrx/game-ready-dictionary",
  "version": "1.1.0",
  "description": "Open-source, pre-compiled Trie-based dictionary for web-based word games.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./data": "./data/medium_trie.json",
    "./small": "./data/small_trie.json",
    "./medium": "./data/medium_trie.json",
    "./large": "./data/large_trie.json",
    "./us": "./data/us_trie.json",
    "./uk": "./data/uk_trie.json",
    "./data/*": "./data/*"
  },
  "type": "module",
  "scripts": {
    "test": "node scripts/test_integrity.js",
    "benchmark": "node scripts/benchmark.js",
    "compile": "python3 pipeline.py",
    "compile:refresh": "python3 pipeline.py --refresh"
  },
  "keywords": [
    "dictionary",
    "word-game",
    "trie",
    "lexicon",
    "gamedev",
    "json",
    "game-development",
    "word-validation"
  ],
  "author": "stonedhawk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stonedhawk/game-ready-dictionary.git"
  },
  "bugs": {
    "url": "https://github.com/stonedhawk/game-ready-dictionary/issues"
  },
  "homepage": "https://github.com/stonedhawk/game-ready-dictionary#readme"
}
